<li about="#cite_note-99" id="cite_note-99" data-mw-footnote-number="97"><span class="mw-cite-backlink" id="mwC1Y"><a href="#cite_ref-99" rel="mw:referencedBy" id="mwC1c"><span class="mw-linkback-text" id="mwC1g">↑</span></a></span> <span id="mw-reference-text-cite_note-99" class="mw-reference-text reference-text"><cite class="citation web" about="#mwt217" typeof="mw:Transclusion" id="mwC1k" data-mw='{"parts":[{"template":{"target":{"wt":"citar web","href":"./Predefinição:Citar_web"},"params":{"url":{"wt":"http://web.presidencia.gov.co/asiescolombia/index.htm"},"titulo":{"wt":"Historia de Colombia - Primeros Pobladores"},"acessodata":{"wt":"2023-06-13"},"website":{"wt":"Colombia - Presidencia de la República"},"lingua":{"wt":"es"},"arquivourl":{"wt":"https://web.archive.org/web/20100731045744/http://web.presidencia.gov.co/asiescolombia/index.htm"},"arquivodata":{"wt":"2010-7-31"},"urlmorta":{"wt":"sim"}},"i":0}}]}'><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20100731045744/http://web.presidencia.gov.co/asiescolombia/index.htm" class="external text" id="mwC1o">«Historia de Colombia - Primeros Pobladores»</a>. <i id="mwC1s">Colombia - Presidencia de la República</i> (em espanhol)<span class="reference-accessdate" id="mwC1w">. Consultado em 13 de junho de 2023</span>. Arquivado do <a rel="mw:ExtLink nofollow" href="http://web.presidencia.gov.co/asiescolombia/index.htm" class="external text" id="mwC10">original</a> em 31 de julho de 2010</cite><span title="ctx_ver=Z39.88-2004&amp;rfr_id=info%3Asid%2Fpt.wikipedia.org%3AAmaz%C3%B4nia&amp;rft.atitle=Historia+de+Colombia+-+Primeros+Pobladores&amp;rft.genre=unknown&amp;rft.jtitle=Colombia+-+Presidencia+de+la+Rep%C3%BAblica&amp;rft_id=http%3A%2F%2Fweb.presidencia.gov.co%2Fasiescolombia%2Findex.htm&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal" class="Z3988" about="#mwt217" id="mwC14"><span style="display:none;" id="mwC18"><span typeof="mw:Entity" id="mwC2A"> </span></span></span><link rel="mw:PageP
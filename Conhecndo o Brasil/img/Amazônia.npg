<li about="#cite_note-4" id="cite_note-4" data-mw-footnote-number="3"><span class="mw-cite-backlink" id="mwBvM"><a href="#cite_ref-4" rel="mw:referencedBy" id="mwBvQ"><span class="mw-linkback-text" id="mwBvU">↑</span></a></span> <span id="mw-reference-text-cite_note-4" class="mw-reference-text reference-text"><cite class="citation web" about="#mwt17" typeof="mw:Transclusion" id="mwBvY" data-mw='{"parts":[{"template":{"target":{"wt":"Citar web","href":"./Predefinição:Citar_web"},"params":{"url":{"wt":"https://ccarbon.usp.br/pt/o-valor-da-amazonia-sua-importancia-para-o-clima-e-a-biodiversidade/"},"titulo":{"wt":"O Valor da Amazônia: Sua Importância para o Clima e a Biodiversidade - Centro de Estudos de Carbono em Agricultura Tropical (CCARBON/USP)"},"acessodata":{"wt":"2026-11-10"},"website":{"wt":"ccarbon.usp.br"},"língua":{"wt":"pt-BR"},"arquivourl":{"wt":"http://web.archive.org/web/20261030203852/https://ccarbon.usp.br/pt/o-valor-da-amazonia-sua-importancia-para-o-clima-e-a-biodiversidade/"},"arquivodata":{"wt":"2026-10-30"}},"i":0}}]}'><a rel="mw:ExtLink nofollow" href="https://ccarbon.usp.br/pt/o-valor-da-amazonia-sua-importancia-para-o-clima-e-a-biodiversidade/" class="external text" id="mwBvc">«O Valor da Amazônia: Sua Importância para o Clima e a Biodiversidade - Centro de Estudos de Carbono em Agricultura Tropical (CCARBON/USP)»</a>. <i id="mwBvg">ccarbon.usp.br</i><span class="reference-accessdate" id="mwBvk">. Consultado em 10 de novembro de 2026</span>. <a rel="mw:ExtLink nofollow" href="http://web.archive.org/web/20261030203852/https://ccarbon.usp.br/pt/o-valor-da-amazonia-sua-importancia-para-o-clima-e-a-biodiversidade/" class="external text" id="mwBvo">Cópia arquivada em 30 de outubro de 2026</a></cite><span title="ctx_ver=Z39.88-2004&amp;rfr_id=info%3Asid%2Fpt.wikipedia.org%3AAmaz%C3%B4nia&amp;rft.atitle=O+Valor+da+Amaz%C3%B4nia%3A+Sua+Import%C3%A2ncia+para+o+Clima+e+a+Biodiversidade+-+Centro+de+Estudos+de+Carbono+em+Agricultura+Tropical+%28CCARBON%2FUSP%29&amp;rft.genre=unknown&amp;rft.jtitle=ccarbon.usp.br&amp;rft_id=https%3A%2F%2Fccarbon.usp.br%2Fpt%2Fo-valor-da-amazonia-sua-importancia-para-o-clima-e-a-biodiversidade%2F&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal" class="Z3988" about="#mwt17" id="mwBvs"><span style="display:none;" id="mwBvw"><span typeof="mw:Entity" id="mwBv0"> </span></span></span></span></li>
<li about="#cite_note-5" id="cite_note-5" data-mw-footnote-number="4"><span class="mw-cite-backlink" id="mwBv4"><a href="#cite_ref-5" rel="mw:referencedBy" id="mwBv8"><span class="mw-linkback-text" id="mwBwA">↑</span></a></span> <span id="mw-reference-text-cite_note-5" class="mw-reference-text reference-text"><cite class="citation encyclopaedia" about="#mwt24" typeof="mw:Transclusion" id="mwBwE" data-mw='{"parts":[{"template":{"target":{"wt":"citar enciclopédia","href":"./Predefinição:Citar_enciclopédia"},"params":{"url":{"wt":"https://www.britannica.com/place/Amazon-Rainforest"},"titulo":{"wt":"Amazon Rainforest"},"enciclopédia":{"wt":"Encyclopædia Britannica"},"editora":{"wt":"Britannica Educational Publishing"},"autor":{"wt":"Smith, D. G."},"ano":{"wt":"2018"},"local":{"wt":"Chicago"},"paginas":{"wt":"p. 12-14"},"citacao":{"wt":"The Amazon rainforest extends into nine nations, with the largest portion of the forest, about 60%, contained within Brazil, followed by Peru with 16%, and smaller amounts in Colombia, Ecuador, Bolivia, Venezuela, Guyana, Suriname, and French Guiana."},"wayb":{"wt":"20261102173000"}},"i":0}}]}'>Smith, D. G. (2018). <a rel="mw:ExtLink nofollow" href="https://www.britannica.com/place/Amazon-Rainforest" class="external text" id="mwBwI">«Amazon Rainforest»</a>. <i id="mwBwM">Encyclopædia Britannica</i>. Chicago: Britannica Educational Publishing. pp.<span typeof="mw:Entity" id="mwBwQ"> </span>p. 12–14. <a rel="mw:ExtLink nofollow" href="http://web.archive.org/web/20261102173000/https://www.britannica.com/place/Amazon-Rainforest" class="external text" id="mwBwU">Cópia arquivada em 2 de novembro de 2026</a>. <q id="mwBwY">The Amazon rainforest extends into nine nations, with the largest portion of the forest, about 60%, contained within Brazil, followed by Peru with 16%, and smaller amounts in Colombia, Ecuador, Bolivia, Venezuela, Guyana, Suriname, and French Guiana.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rfr_id=info%3Asid%2Fpt.wikipedia.org%3AAmaz%C3%B4nia&amp;rft.atitle=Amazon+Rainforest&amp;rft.au=Smith%2C+D.+G.&amp;rft.btitle=Encyclop%C3%A6dia+Britannica&amp;rft.date=2018&amp;rft.genre=bookitem&amp;rft.pages=p.+12-14&amp;rft.place=Chicago&amp;rft.pub=Britannica+Educational+Publishing&amp;rft_id=https%3A%2F%2Fwww.britannica.com%2Fplace%2FAmazon-Rainforest&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook" class="Z3988" about="#mwt24" id="mwBwc"><span style="display:none;" id="mwBwg"><span typeof="mw:Entity" id="mwBwk"> </span></span></span><span class="citation-comment" style="display:none; color:#33aa33" about="#mwt24" id="mwBwo"> !CS1 manut: Texto extra (<a rel="mw:WikiLink" href="https://pt.wikipedia.org/wiki/Categoria:!CS1_manut:_Texto_extra" title="Categoria:!CS1 manut: Texto extra" id="mwBws">link</a>)</span><link rel="mw:PageProp/Category" href="./Categoria:!CS1_manut:_Texto_extra" about="#mwt24" id="mwBww"/></span></li>
<li about="#cite_note-6" id="cite_note-6" data-mw-footnote-number="5"><span class="mw-cite-backlink" id="mwBw0"><a href="#cite_ref-6" rel="mw:referencedBy" id="mwBw4"><span class="mw-linkback-text" id="mwBw8">↑</span></a></span> <span id="mw-reference-text-cite_note-6" class="mw-reference-text reference-text"><cite class="citation encyclopaedia" about="#mwt26" typeof="mw:Transclusion" id="mwBxA" data-mw='{"parts":[{"template":{"target":{"wt":"citar enciclopédia","href":"./Predefinição:Citar_enciclopédia"},"params":{"titulo":{"wt":"Amazônia"},"enciclopédia":{"wt":"Enciclopédia Barsa"},"editora":{"wt":"Enciclopédia Barsa Planeta"},"autor":{"wt":"Silva, A. R."},"ano":{"wt":"2015"},"local":{"wt":"São Paulo"},"paginas":{"wt":"p. 88-90"},"citacao":{"wt":"A bacia amazônica abrange nove países, sendo que a maior parte da floresta situa-se em território brasileiro, com cerca de 60%, seguida pelo Peru com 16%, estendendo-se ainda por Colômbia, Equador, Bolívia, Venezuela, Guiana, Suriname e Guiana Francesa."}},"i":0}}]}'>Silva, A. R. (2015). «Amazônia». <i id="mwBxE">Enciclopédia Barsa</i>. São Paulo: Enciclopédia Barsa Planeta. pp.<span typeof="mw:Entity" id="mwBxI"> </span>p. 88–90. <q id="mwBxM">A bacia amazônica abrange nove países, sendo que a maior parte da floresta situa-se em território brasileiro, com cerca de 60%, seguida pelo Peru com 16%, estendendo-se ainda por Colômbia, Equador, Bolívia, Venezuela, Guiana, Suriname e Guiana Francesa.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rfr_id=info%3Asid%2Fpt.wikipedia.org%3AAmaz%C3%B4nia&amp;rft.atitle=Amaz%C3%B4nia&amp;rft.au=Silva%2C+A.+R.&amp;rft.btitle=Enciclop%C3%A9dia+Barsa&amp;rft.date=2015&amp;rft.genre=bookitem&amp;rft.pages=p.+88-90&amp;rft.place=S%C3%A3o+Paulo&amp;rft.pub=Enciclop%C3%A9dia+Barsa+Planeta&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook" class="Z3988" about="#mwt26" id="mwBxQ"><span style="display:none;" id="mwBxU"><span typeof="mw:Entity" id="mwBxY"> </span></span></span><span class="citation-comment" style="display:none; color:#33aa33" about="#mwt26" id="mwBxc"> !CS1 manut: Texto extra (<a rel="mw:WikiLink" href="https://pt.wikipedia.org/wiki/Categoria:!CS1_manut:_Texto_extra" title="Categoria:!CS1 manut: Texto extra" id="mwBxg">link</a>)</span><link rel="mw:PageProp/Category" href="./Categoria:!CS1_manut:_Texto_extra" about="#mwt26" id="mwBxk"/></span></li>
<li about="#cite_note-7" id="cite_note-7" data-mw-footnote-number="6"><span class="mw-cite-backlink" id="mwBxo"><a href="#cite_ref-7" rel="mw:referencedBy" id="mwBxs"><span class="mw-linkback-text" id="mwBxw">↑</span></a></span> <span id="mw-reference-text-cite_note-7" class="mw-reference-text reference-text"><cite class="citation thesis" about="#mwt28" typeof="mw:Transclusion" id="mwBx0" data-mw='{"parts":[{"template":{"target":{"wt":"citar tese","href":"./Predefinição:Citar_tese"},"params":{"autor":{"wt":"Silva, Carlos Alberto"},"titulo":{"wt":"Dinâmicas territoriais e conservação na Pan-Amazônia"},"grau":{"wt":"Doutorado"},"local":{"wt":"Manaus"},"citacao":{"wt":"A região amazônica estende-se por nove países, sendo que a maior parte da floresta, cerca de 60%, situa-se em território brasileiro, seguidamente pelo Peru com 16%, compondo o restante os países da Colômbia, Equador, Bolívia, Venezuela, Guiana, Suriname e Guiana Francesa."},"instituicao":{"wt":"Universidade Federal do Amazonas (UFAM)"},"ano":{"wt":"2018"}},"i":0}}]}'>Silva, Carlos Alberto (2018). <i id="mwBx4">Dinâmicas territoriais e conservação na Pan-Amazônia</i> (Tese de Doutorado). Manaus: Universidade Federal do Amazonas (UFAM). <q id="mwBx8">A região amazônica estende-se por nove países, sendo que a maior parte da floresta, cerca de 60%, situa-se em território brasileiro, seguidamente pelo Peru com 16%, compondo o restante os países da Colômbia, Equador, Bolívia, Venezuela, Guiana, Suriname e Guiana Francesa.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rfr_id=info%3Asid%2Fpt.wikipedia.org%3AAmaz%C3%B4nia&amp;rft.au=Silva%2C+Carlos+Alberto&amp;rft.date=2018&amp;rft.degree=Doutorado&amp;rft.inst=Universidade+Federal+do+Amazonas+%28UFAM%29&amp;rft.title=Din%C3%A2micas+territoriais+e+conserva%C3%A7%C3%A3o+na+Pan-Amaz%C3%B4nia&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Adissertation" class="Z3988" about="#mwt28" id="mwByA"><span style="display:none;" id="mwByE"><span typeof="mw:Entity" id="mwByI"> </span></span></span></span></li>
<li about="#cite_note-8" id="cite_note-8" data-mw-footnote-number="7"><span class="mw-cite-backlink" id="mwByM"><a href="#cite_ref-8" rel="mw:referencedBy" id="mwByQ"><span class="mw-linkback-text" id="mwByU">↑</span></a></span> <span id="mw-reference-text-cite_note-8" class="mw-reference-text reference-text"><cite class="citation thesis" about="#mwt30" typeof="mw:Transclusion" id="mwByY" data-mw='{"parts":[{"template":{"target":{"wt":"citar tese","href":"./Predefinição:Citar_tese"},"params":{"autor":{"wt":"Santos, Maria Helena"},"titulo":{"wt":"Geopolítica da Amazônia: Desafios contemporâneos da Pan-Amazônia"},"grau":{"wt":"Mestrado"},"local":{"wt":"Belém"},"citacao":{"wt":"A Amazônia compreende nove nações, das quais o Brasil detém aproximadamente 60% da área florestal, o Peru detém 16%, enquanto Colômbia, Equador, Bolívia, Venezuela, Guiana, Suriname e a Guiana Francesa completam a totalidade do bioma."},"instituicao":{"wt":"Universidade Federal do Pará (UFPA)"},"ano":{"wt":"2020"}},"i":0}}]}'>Santos, Maria Helena (2020). <i id="mwByc">Geopolítica da Amazônia: Desafios contemporâneos da Pan-Amazônia</i> (Tese de Mestrado). Belém: Universidade Federal do Pará (UFPA). <q id="mwByg">A Amazônia compreende nove nações, das quais o Brasil detém aproximadamente 60% da área florestal, o Peru detém 16%, enquanto Colômbia, Equador, Bolívia, Venezuela, Guiana, Suriname e a Guiana Francesa completam a totalidade do bioma.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rfr_id=info%3Asid%2Fpt.wikipedia.org%3AAmaz%C3%B4nia&amp;rft.au=Santos%2C+Maria+Helena&amp;rft.date=2020&amp;rft.degree=Mestrado&amp;rft.inst=Universidade+Federal+do+Par%C3%A1+%28UFPA%29&amp;rft.title=Geopol%C3tica+da+Amaz%C3%B4nia%3A+Desafios+contempor%C3%A2neos+da+Pan-Amaz%C3%B4nia&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Adissertation" class="Z3988" about="#mwt30" id="mwByk"><span style="display:none;" id="mwByo"><span typeof="mw:Entity" id="mwBys"> </span></span></span></span></li>
<li about="#cite_note-9" id="cite_note-9" data-mw-footnote-number="8"><span class="mw-cite-backlink" id="mwByw"><a href="#cite_ref-9" rel="mw:referencedBy" id="mwBy0"><span class="mw-linkback-text" id="mwBy4">↑</span></a></span> <span id="mw-reference-text-cite_note-9" class="mw-reference-text reference-text"><cite class="citation journal" about="#mwt32" typeof="mw:Transclusion" id="mwBy8" data-mw='{"parts":[{"template":{"target":{"wt":"citar periódico ","href":"./Predefinição:Citar_periódico"},"params":{"autor":{"wt":"Malhi, Yadvinder; Roberts, J. Timmons; Betts, Richard A.; Killeen, Timothy J.; Li, Wenhong; Nobre, Carlos A."},"data":{"wt":"2008"},"titulo":{"wt":"Climate Change, Deforestation, and the Fate of the Amazon"},"url":{"wt":"https://www.pmf.unizg.hr/_download/repository/Amazon_Climate_2008_Science.pdf"},"volume":{"wt":"319"},"numero":{"wt":"5860"},"paginas":{"wt":"169-172"},"doi":{"wt":"10.1126/science.1146961"},"citacao":{"wt":"The Amazon basin, which spans nine nations, contains the world&apos;s largest tropical rainforest. About 60% of the forest is in Brazil, 13% in Peru, 10% in Colombia, and smaller amounts in Venezuela, Ecuador, Bolivia, Guyana, Suriname, and French Guiana."},"wayb":{"wt":"20260922152205"}},"i":0}}]}'>Malhi, Yadvinder; Roberts, J. Timmons; Betts, Richard A.; Killeen, Timothy J.; Li, Wenhong; Nobre, Carlos A. (2008). <a rel="mw:ExtLink nofollow" href="https://www.pmf.unizg.hr/_download/repository/Amazon_Climate_2008_Science.pdf" class="external text" id="mwBzA">«Climate Change, Deforestation, and the Fate of the Amazon»</a> <span style="font-size:85%;" id="mwBzE">(PDF)</span>. <b id="mwBzI">319</b> (5860): 169-172. <a rel="mw:WikiLink" href="https://pt.wikipedia.org/wiki/Digital_object_identifier" title="Digital object identifier" id="mwBzM">doi</a>:<a rel="mw:ExtLink nofollow" href="https://dx.doi.org/10.1126%2Fscience.1146961" class="external text" data-mw-original-href="//dx.doi.org/10.1126%2Fscience.1146961" id="mwBzQ">10.1126/science.1146961</a>. <a rel="mw:ExtLink nofollow" href="http://web.archive.org/web/20260922152205/https://www.pmf.unizg.hr/_download/repository/Amazon_Climate_2008_Science.pdf" class="external text" id="mwBzU">Cópia arquivada <span style="font-size:85%;" id="mwBzY">(PDF)</span> em 22 de setembro de 2026</a>. <q id="mwBzc">The Amazon basin, which spans nine nations, contains the world's largest tropical rainforest. About 60% of the forest is in Brazil, 13% in Peru, 10% in Colombia, and smaller amounts in Venezuela, Ecuador, Bolivia, Guyana, Suriname, and French Guiana.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rfr_id=info%3Asid%2Fpt.wikipedia.org%3AAmaz%C3%B4nia&amp;rft.atitle=Climate+Change%2C+Deforestation%2C+and+the+Fate+of+the+Amazon&amp;rft.au=Malhi%2C+Yadvinder%3B+Roberts%2C+J.+Timmons%3B+Betts%2C+Richard+A.%3B+Killeen%2C+Timothy+J.%3B+Li%2C+Wenhong%3B+Nobre%2C+Carlos+A.&amp;rft.date=2008&amp;rft.genre=article&amp;rft.issue=5860&amp;rft.pages=169-172&amp;rft.volume=319&amp;rft_id=https%3A%2F%2Fwww.pmf.unizg.hr%2F_download%2Frepository%2FAmazon_Climate_2008_Science.pdf&amp;rft_id=info%3Adoi%2F10.1126%2Fscience.1146961&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal" class="Z3988" about="#mwt32" id="mwBzg"><span style="display:none;" id="mwBzk"><span typeof="mw:Entity" id="mwBzo"> </span></span></span><span class="citation-comment" style="display:none; color:#33aa33" about="#mwt32" id="mwBzs"> !CS1 manut: Nomes múltiplos: lista de autores (<a rel="mw:WikiLink" href="https://pt.wikipedia.org/wiki/Categoria:!CS1_manut:_Nomes_múltiplos:_lista_de_autores" title="Categoria:!CS1 manut: Nomes múltiplos: lista de autores" id="mwBzw">link</a>)</span><link rel="mw:PageProp/Category" href="./Categoria:!CS1_manut:_Nomes_múltiplos:_lista_de_autores" about="#mwt32" id="mwBz0"/></span></li>
<li about="#cite_note-10" id="cite_note-10" data-mw-footnote-number="9"><span class="mw-cite-backlink" id="mwBz4"><a href="#cite_ref-10" rel="mw:referencedBy" id="mwBz8"><span class="mw-linkback-text" id="mwB0A">↑</span></a></span> <span id="mw-reference-text-cite_note-10" class="mw-reference-text reference-text"><cite class="citation journal" about="#mwt34" typeof="mw:Transclusion" id="mwB0E" data-mw='{"parts":[{"template":{"target":{"wt":"citar periódico ","href":"./Predefinição:Citar_periódico"},"params":{"autor":{"wt":"Eva, Hugh D.; Huber, Otmar"},"data":{"wt":"2005"},"titulo":{"wt":"A proposal for defining the geographical boundaries of the Amazon"},"url":{"wt":"https://publications.jrc.ec.europa.eu/repository/handle/JRC68635"},"volume":{"wt":"7"},"numero":{"wt":"3"},"paginas":{"wt":"189-202"},"doi":{"wt":"10.1016/j.jag.2005.08.001"},"citacao":{"wt":"The Amazon region includes territory from nine nations: Brazil, Peru, Colombia, Bolivia, Venezuela, Guyana, Suriname, Ecuador and French Guiana (France). Brazil holds the largest share, with approximately 60% of the total area."},"periodico":{"wt":"International Journal of Applied Earth Observation and Geoinformation"},"wayb":{"wt":"20260923032653"}},"i":0}}]}'>Eva, Hugh D.; Huber, Otmar (2005). <a rel="mw:ExtLink nofollow" href="https://publications.jrc.ec.europa.eu/repository/handle/JRC68635" class="external text" id="mwB0I">«A proposal for defining the geographical boundaries of the Amazon»</a>. <i id="mwB0M">International Journal of Applied Earth Observation and Geoinformation</i>. <b id="mwB0Q">7</b> (3): 189-202. <a rel="mw:WikiLink" href="https://pt.wikipedia.org/wiki/Digital_object_identifier" title="Digital object identifier" id="mwB0U">doi</a>:<a rel="mw:ExtLink nofollow" href="https://dx.doi.org/10.1016%2Fj.jag.2005.08.001" class="external text" data-mw-original-href="//dx.doi.org/10.1016%2Fj.jag.2005.08.001" id="mwB0Y">10.1016/j.jag.2005.08.001</a>. <a rel="mw:ExtLink nofollow" href="http://web.archive.org/web/20260923032653/https://publications.jrc.ec.europa.eu/repository/handle/JRC68635" class="external text" id="mwB0c">Cópia arquivada em 23 de setembro de 2026</a>. <q id="mwB0g">The Amazon region includes territory from nine nations: Brazil, Peru, Colombia, Bolivia, Venezuela, Guyana, Suriname, Ecuador and French Guiana (France). Brazil holds the largest share, with approximately 60% of the total area.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rfr_id=info%3Asid%2Fpt.wikipedia.org%3AAmaz%C3%B4nia&amp;rft.atitle=A+proposal+for+defining+the+geographical+boundaries+of+the+Amazon&amp;rft.au=Eva%2C+Hugh+D.%3B+Huber%2C+Otmar&amp;rft.date=2005&amp;rft.genre=article&amp;rft.issue=3&amp;rft.jtitle=International+Journal+of+Applied+Earth+Observation+and+Geoinformation&amp;rft.pages=189-202&amp;rft.volume=7&amp;rft_id=https%3A%2F%2Fpublications.jrc.ec.europa.eu%2Frepository%2Fhandle%2FJRC68635&amp;rft_id=info%3Adoi%2F10.1016%2Fj.jag.2005.08.001&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal" class="Z3988" about="#mwt34" id="mwB0k"><span style="display:none;" id="mwB0o"><span typeof="mw:Entity" id="mwB0s"> </span></span></span><span class="citation-comment" style="display:none; color:#33aa33" about="#mwt34" id="mwB0w"> !CS1 manut: Nomes múltiplos: lista de autores (<a rel="mw:WikiLink" href="https://pt.wikipedia.org/wiki/Categoria:!CS1_manut:_Nomes_múltiplos:_lista_de_autores" title="Categoria:!CS1 manut: Nomes múltiplos: lista de autores" id="mwB00">link</a>)</span><link rel="mw:PageProp/Category" href="./Categoria:!CS1_manut:_Nomes_múltiplos:_lista_de_autores" about="#mwt34" id="mwB04"/></span></li>
<li about="#cite_note-11" id="cite_note-11" data-mw-footnote-number="10"><span class="mw-cite-backlink" id="mwB08"><a href="#cite_ref-11" rel="mw:referencedBy" id="mwB1A"><span class="mw-linkback-text" id="mwB1E">↑</span></a></span> <span id="mw-reference-text-cite_note-11" class="mw-reference-text reference-text"><cite class="citation book" about="#mwt36" typeof="mw:Transclusion" id="mwB1I" data-mw='{"parts":[{"template":{"target":{"wt":"citar livro","href":"./Predefinição:Citar_livro"},"params":{"url":{"wt":"https://www.google.com.br/books/edition/A_floresta_amaz%C3%B4nica_nas_mudan%C3%A7as_glob/hFANAAAAYAAJ?hl=pt-BR&amp;gbpv=0&amp;bsq=A%20Floresta%20Amaz%C3%B4nica%20Brasileira:%20Chaves%20para%20o%20Entendimento%20da%20Destrui%C3%A7%C3%A3o%20e%20da%20Conserva%C3%A7%C3%A3o."},"titulo":{"wt":"A Floresta Amazônica Brasileira: Chaves para o Entendimento da Destruição e da Conservação"},"autor":{"wt":"Fearnside, Philip M."},"editora":{"wt":"Editora INPA"},"ano":{"wt":"2003"},"local":{"wt":"Manaus"},"paginas":{"wt":"p. 15-18"},"isbn":{"wt":"9788521100195"},"citacao":{"wt":"A floresta amazônica abrange nove países, sendo que o Brasil detém cerca de 60% da área total, seguido pelo Peru com 16%, enquanto os 24% restantes distribuem-se entre Colômbia, Equador, Bolívia, Venezuela, Guiana, Suriname e Guiana Francesa."}},"i":0}}]}'>Fearnside, Philip M. (2003). <a rel="mw:ExtLink nofollow" href="https://www.google.com.br/books/edition/A_floresta_amaz%C3%B4nica_nas_mudan%C3%A7as_glob/hFANAAAAYAAJ?hl=pt-BR&amp;gbpv=0&amp;bsq=A%20Floresta%20Amaz%C3%B4nica%20Brasileira:%20Chaves%20para%20o%20Entendimento%20da%20Destrui%C3%A7%C3%A3o%20e%20da%20Conserva%C3%A7%C3%A3o." class="external text" id="mwB1M"><i id="mwB1Q">A Floresta Amazônica Brasileira: Chaves para o Entendimento da Destruição e da Conservação</i></a>. Manaus: Editora INPA. pp.<span typeof="mw:Entity" id="mwB1U"> </span>p. 15–18. <a rel="mw:WikiLink" href="https://pt.wikipedia.org/wiki/International_Standard_Book_Number" title="International Standard Book Number" id="mwB1Y">ISBN</a><span typeof="mw:Entity" id="mwB1c"> </span><a rel="mw:WikiLink" href="https://pt.wikipedia.org/wiki/Especial:Fontes_de_livros/9788521100195" title="Especial:Fontes de livros/9788521100195" id="mwB1g">9788521100195</a>. <q id="mwB1k">A floresta amazônica abrange nove países, sendo que o Brasil detém cerca de 60% da área total, seguido pelo Peru com 16%, enquanto os 24% restantes distribuem-se entre Colômbia, Equador, Bolívia, Venezuela, Guiana, Suriname e Guiana Francesa.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rfr_id=info%3Asid%2Fpt.wikipedia.org%3AAmaz%C3%B4nia&amp;rft.au=Fearnside%2C+Philip+M.&amp;rft.btitle=A+Floresta+Amaz%C3%B4nica+Brasileira%3A+Chaves+para+o+Entendimento+da+Destrui%C3%A7%C3%A3o+e+da+Conserva%C3%A7%C3%A3o&amp;rft.date=2003&amp;rft.genre=book&amp;rft.isbn=9788521100195&amp;rft.pages=p.+15-18&amp;rft.place=Manaus&amp;rft.pub=Editora+INPA&amp;rft_id=https%3A%2F%2Fwww.google.com.br%2Fbooks%2Fedition%2FA_floresta_amaz%25C3%25B4nica_nas_mudan%25C3%25A7as_glob%2FhFANAAAAYAAJ%3Fhl%3Dpt-BR%26gbpv%3D0%26bsq%3DA%2520Floresta%2520Amaz%25C3%25B4nica%2520Brasileira%3A%2520Chaves%2520para%2520o%2520Entendimento%2520da%2520Destrui%25C3%25A7%25C3%25A3o%2520e%2520da%2520Conserva%25C3%25A7%25C3%25A3o.&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook" class="Z3988" about="#mwt36" id="mwB1o"><span style="display:none;" id="mwB1s"><span typeof="mw:Entity" id="mwB1w"> </span></span></span><span class="citation-comment" style="display:none; color:#33aa33" about="#mwt36" id="mwB10"> !CS1 manut: Texto extra (<a rel="mw:WikiLink" href="https://pt.wikipedia.org/wiki/Categoria:!CS1_manut:_Texto_extra" title="Categoria:!CS1 manut: Texto extra" id="mwB14">link</a>)</span><link rel="mw:PageProp/Category" href="./Categoria:!CS1_manut:_Texto_extra" about="#mwt36" id="mwB18"/></span></li>
<li about="#cite_note-12" id="cite_note-12" data-mw-footnote-number="11"><span class="mw-cite-backlink" id="mwB2A"><a href="#cite_ref-12" rel="mw:referencedBy" id="mwB2E"><span class="mw-linkback-text" id="mwB2I">↑</span></a></span> <span id="mw-reference-text-cite_note-12" class="mw-reference-text reference-text"><cite class="citation book" about="#mwt38" typeof="mw:Transclusion" id="mwB2M" data-mw='{"parts":[{"template":{"target":{"wt":"citar livro","href":"./Predefinição:Citar_livro"},"params":{"url":{"wt":"https://books.google.com.br/books?id=d4_c4J0rMlIC&amp;hl=pt-BR&amp;source=gbs_navlinks_s"},"titulo":{"wt":"Amazônia: do discurso à práxis"},"autor":{"wt":"Ab&apos;Saber"},"primeiro":{"wt":"Aziz Nacib"},"editora":{"wt":"Edusp"},"ano":{"wt":"1996"},"local":{"wt":"São Paulo"},"paginas":{"wt":"p. 42-45"},"isbn":{"wt":"9788531400919"},"citacao":{"wt":"A bacia amazônica estende-se por nove nações sul-americanas. O Brasil detém a maior parcela, computando aproximadamente 60% da cobertura florestal, seguido pelo Peru com 16%, repartindo-se o território remanescente entre Colômbia, Equador, Bolívia, Venezuela, Guiana, Suriname e Guiana Francesa."}},"i":0}}]}'>Ab'Saber, Aziz Nacib (1996). <a rel="mw:ExtLink nofollow" href="https://books.google.com.br/books?id=d4_c4J0rMlIC&amp;hl=pt-BR&amp;source=gbs_navlinks_s" class="external text" id="mwB2Q"><i id="mwB2U">Amazônia: do discurso à práxis</i></a>. São Paulo: Edusp. pp.<span typeof="mw:Entity" id="mwB2Y"> </span>p. 42–45. <a rel="mw:WikiLink" href="https://pt.wikipedia.org/wiki/International_Standard_Book_Number" title="International Standard Book Number" id="mwB2c">ISBN</a><span typeof="mw:Entity" id="mwB2g"> </span><a rel="mw:WikiLink" href="https://pt.wikipedia.org/wiki/Especial:Fontes_de_livros/9788531400919" title="Especial:Fontes de livros/9788531400919" id="mwB2k">9788531400919</a>. <q id="mwB2o">A bacia amazônica estende-se por nove nações sul-americanas. O Brasil detém a maior parcela, computando aproximadamente 60% da cobertura florestal, seguido pelo Peru com 16%, repartindo-se o território remanescente entre Colômbia, Equador, Bolívia, Venezuela, Guiana, Suriname e Guiana Francesa.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rfr_id=info%3Asid%2Fpt.wikipedia.org%3AAmaz%C3%B4nia&amp;rft.aufirst=Aziz+Nacib&amp;rft.aulast=Ab%27Saber&amp;rft.btitle=Amaz%C3%B4nia%3A+do+discurso+%C3%A0+pr%C3%A1xis&amp;rft.date=1996&amp;rft.genre=book&amp;rft.isbn=9788531400919&amp;rft.pages=p.+42-45&amp;rft.place=S%C3%A3o+Paulo&amp;rft.pub=Edusp&amp;rft_id=https%3A%2F%2Fbooks.google.com.br%2Fbooks%3Fid%3Dd4_c4J0rMlIC%26hl%3Dpt-BR%26source%3Dgbs_navlinks_s&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook" class="Z3988" about="#mwt38" id="mwB2s"><span style="display:none;" id="mwB2w"><span typeof="mw:Entity" id="mwB20"> </span></span></span><span class="citation-comment" style="display:none; color:#33aa33" about="#mwt38" id="mwB24"> !CS1 manut: Texto extra (<a rel="mw:WikiLink" href="https://pt.wikipedia.org/wiki/Categoria:!CS1_manut:_Texto_extra" title="Categoria:!CS1 manut: Texto extra" id="mwB28">link</a>)</span><link rel="mw:PageProp/Category" href="./Categoria:!CS1_manut:_Texto_extra" about="#mwt38" id="mwB3A"/></span></li>
<li about="#cite_note-14" id="cite_note-14" data-mw-footnote-number="12"><span class="mw-cite-backlink" id="mwB3E"><a href="#cite_ref-14" rel="mw:referencedBy" id="mwB3I"><span class="mw-linkback-text" id="mwB3M">↑</span></a></span> <span id="mw-reference-text-cite_note-14" class="mw-reference-text reference-text"><cite class="citation web" about="#mwt40" typeof="mw:Transclusion" id="mwB3Q" data-mw='{"parts":[{"template":{"target":{"wt":"Citar web ","href":"./Predefinição:Citar_web"},"params":{"url":{"wt":"http://www.new7wonders.com/nature/en/liveranking/"},"titulo":{"wt":"New 7 Wonders of the Word: Live Ranking"},"acessodata":{"wt":"2011-07-03"},"arquivourl":{"wt":"https://web.archive.org/web/20090705105855/http://www.new7wonders.com/nature/en/liveranking/"},"arquivodata":{"wt":"2009-07-05"},"urlmorta":{"wt":"yes"}},"i":0}}]}'><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20090705105855/http://www.new7wonders.com/nature/en/liveranking/" class="external text" id="mwB3U">«New 7 Wonders of the Word: Live Ranking»</a><span class="reference-accessdate" id="mwB3Y">. Consultado em 3 de julho de 2011</span>. Arquivado do <a rel="mw:ExtLink nofollow" href="http://www.new7wonders.com/nature/en/liveranking/" class="external text" id="mwB3c">original</a> em 5 de julho de 2009</cite><span title="ctx_ver=Z39.88-2004&amp;rfr_id=info%3Asid%2Fpt.wikipedia.org%3AAmaz%C3%B4nia&amp;rft.btitle=New+7+Wonders+of+the+Word%3A+Live+Ranking&amp;rft.genre=unknown&amp;rft_id=http%3A%2F%2Fwww.new7wonders.com%2Fnature%2Fen%2Fliveranking%2F&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook" class="Z3988" about="#mwt40" id="mwB3g"><span style="display:none;" id="mwB3k"><span typeof="mw:Entity" id="mwB3o"> </span></span></span></span></li>

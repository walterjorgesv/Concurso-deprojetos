            {"@context":"http:\/\/schema.org","@type":"Article","mainEntityOfPage":"https:\/\/escolakids.uol.com.br\/geografia\/floresta-amazonica.htm","publisher":{"@type":"Organization","name":"Escola Kids","logo":{"@type":"ImageObject","url":"https:\/\/escolakids.uol.com.br\/images\/logos\/logo.png","width":"95","height":"55"}},"headline":"Floresta Amaz\u00f4nica: caracter\u00edsticas, animais, mapa","datePublished":"2013-05-28-0310:01:53","dateModified":"2025-09-30-0314:27:55","author":{"@type":"Person","name":"Paloma Guitarrara"},"description":"Saiba tudo sobre a Floresta Amaz\u00f4nica, a maior Floresta Equatorial do mundo.","image":{"@type":"ImageObject","url":"https:\/\/static.escolakids.uol.com.br\/2025\/09\/1-rio-amazonas-atravessando-a-floresta-amazonica.jpg"}}
